COMPUTATIONAL_DOMAIN_XLLCORNER=0.0
COMPUTATIONAL_DOMAIN_YLLCORNER=0.0
/

&TIME_CONTROL
SIMULATION_DT=0.74515648
SIMULATION_DTMAX=20.0
