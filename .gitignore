# Regenerable repository-level report and scratch artifacts
/main_report/generated/
/output/
/tmp/

# Folders inside the unit test cases to ignore
cases/Verification/unit_tests/*/data/
cases/Verification/unit_tests/*/figures/
cases/Verification/unit_tests/*/logs/
cases/Verification/unit_tests/*/outputs/
cases/Verification/unit_tests/*/report/
cases/Verification/unit_tests/*/scratch/

# Every active verification variant tree is regenerated by its case-local
# preprocessor.  Source definitions and special namelist templates belong
# outside variants/ (for example under scripts/namelists/).
cases/Verification/unit_tests/CASE*/variants/
cases/Verification/coupling_tests/CASE*/variants/

# Regenerable inputs for the portable Adam successors
cases/Verification/coupling_tests/CASE30_MIT/data/
cases/Verification/coupling_tests/CASE31_PFT/data/
cases/Verification/coupling_tests/CASE32_RCV/data/
cases/Verification/coupling_tests/CASE33_SDO/data/

# Source reports and frozen fuel tables for the Rothermel sweep cases.  Their
# generated variants, figures, outputs, logs, PDFs, and metrics macros remain
# covered by the broader artifact rules above.
